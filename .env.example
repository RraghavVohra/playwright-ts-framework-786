# ============================================================
# .env.example — commit THIS file to git.
# Copy it to a real ".env" locally and fill in actual values.
# ".env" itself is git-ignored and must NEVER be committed.
# ============================================================


# ------------------------------------------------------------
# 1. REQUIRED — every team member must set these, or tests
#    crash immediately at the login step (auth.setup.ts).
#    Get the real values from [your team's shared vault /
#    password manager — fill this in once you pick one].
# ------------------------------------------------------------
USER_EMAIL=
USER_PASSWORD=


# ------------------------------------------------------------
# 2. WHICH SERVER TO RUN AGAINST
#    One of: dev | preprod | prod | digipulse
#    Defaults to 'digipulse' if left unset (see config.ts).
#    Every team member should set this explicitly rather than
#    relying on the default, so it's always obvious which
#    server their local run just hit.
# ------------------------------------------------------------
ENV=digipulse


# ------------------------------------------------------------
# 3. OPTIONAL — environment-specific test data.
#    Every value below already has a working default baked
#    into config.ts, confirmed against the 'digipulse' server.
#    Leave these blank unless ENV above is set to something
#    OTHER than digipulse — dev/preprod/prod may use different
#    category names, hashtags, or asset labels, and a mismatch
#    here fails a test for data reasons, not a real bug.
#    Ask whoever last tested that environment for the correct
#    values before overriding.
# ------------------------------------------------------------

# Push Notification tests
CUSTOM_LINK=

# Document Library tests
PARTNER_CATEGORY_NAME=
DOCUMENT_NAME=
HASHTAG_TEXT=

# Banners tests
BANNER_NAME=

# Social Post Asset tests
SOCIAL_POST_ASSET_NAME=

# Brochure tests
BROCHURE_NAME=
BROCHURE_CATEGORY=
BROCHURE_HASHTAG=
BROCHURE_CATEGORY_2=
BROCHURE_HASHTAG_2=

# Video Asset tests
VIDEO_ASSET_NAME=
VIDEO_HASHTAG=

# Social Auto-Post tests
SOCIAL_PARTNER_SEARCH=
SOCIAL_PARTNER_NAME=
SOCIAL_TITLE=
SOCIAL_DESCRIPTION=
SOCIAL_CUSTOM_URL=