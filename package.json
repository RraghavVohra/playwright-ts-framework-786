{
  "name": "playwright-ts-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run clean:reports && npx playwright test",
    "test:smoke": "npm run clean:reports && npx playwright test --grep @smoke",
    "test:regression": "npm run clean:reports && npx playwright test --grep @regression",
    "test:azure": "npm run clean:reports && npx playwright test --config=playwright.service.config.ts --workers=4",
    "test:azure:file": "npx playwright test --config=playwright.service.config.ts --workers=4",
    "report": "allure generate allure-results --clean && allure open",
    "report:show": "npx playwright show-report",
    "report:azure": "npx playwright show-report azure-report",
    "clean:reports": "rimraf playwright-report allure-report allure-results azure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/playwright": "^1.1.5",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "allure-playwright": "^3.9.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  }
}
